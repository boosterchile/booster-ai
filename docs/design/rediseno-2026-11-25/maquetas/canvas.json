      "kind": "title1",
      "maxW": 17600
    },
    "t-movil": {
      "x": 0,
      "y": 7550,
      "text": "Diseño responsivo: las mismas pantallas a ancho de teléfono",
      "kind": "title1",
      "maxW": 2740
    },
    "n-resp": {
      "x": 2900,
      "y": 7850,
      "w": 400,
      "text": "Cada pantalla de operador es un solo diseño fluido: las columnas se apilan, las tablas se desplazan dentro de su caja y el menú superior pasa a una barra inferior bajo 640 px. Las de esta fila son los mismos archivos que arriba, vistos a 390 px.",
