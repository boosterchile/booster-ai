# Booster AI Web — variables de entorno (frontend)
# Las variables prefijadas con VITE_ quedan disponibles en el bundle.
# NO poner secrets del backend aquí.

VITE_API_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=booster-ai-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=booster-ai-dev
VITE_FIREBASE_STORAGE_BUCKET=booster-ai-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=XXXXXXXXX
VITE_FIREBASE_APP_ID=1:XXX:web:XXX
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-frontend-key
# Site key de reCAPTCHA (pública) para Firebase App Check. Requerida. Es la del
# proveedor que indique VITE_APPCHECK_PROVIDER.
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Proveedor de App Check: recaptcha-v3 (clásico, obsoleto; solo para apps ya
# registradas con él) o recaptcha-enterprise (Fraud Defense). Vacío = recaptcha-v3.
VITE_APPCHECK_PROVIDER=
# Sentry DSN (público; ADR-074). Vacío = sink de errores deshabilitado (dev/CI).
VITE_SENTRY_DSN=
# Auth emulator local (Slot 3 paso 6). NUNCA true en Cloud Build / prod.
# Con true, connectAuthEmulator pega SOLO a loopback (default :9099).
# VITE_USE_AUTH_EMULATOR=false
# VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
