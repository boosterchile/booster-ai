# Booster AI — variables de STAGING (ADR-083).
# Copiar a environments/staging/terraform.tfvars (gitignored) y completar.
#   terraform -chdir=infrastructure plan -var-file=environments/staging/terraform.tfvars
# Mismo root module que prod; solo cambian identidad, dominio y tamaños.
#
# Checklist en seco (quién hace qué, gaps): docs/handoff/2026-11-16-staging-checklist-adr083.md
# Runbook: docs/runbooks/staging.md
#
# NO committear terraform.tfvars. NO poner secretos aquí.

# --- Identidad del proyecto ---
project_id  = "booster-ai-stg-494222" # confirmar disponibilidad del ID al crearlo (PO)
environment = "staging"
domain      = "staging.boosterchile.com"
region      = "southamerica-west1"
zone        = "southamerica-west1-a"

# Misma org y misma cuenta de facturación que prod (gcloud billing accounts list).
# Completar SOLO en la copia local terraform.tfvars — lo hace el PO.
billing_account = "XXXXXX-XXXXXX-XXXXXX"
organization_id = "435506363892"

# --- Identidad humana / GitHub (WIF propio del proyecto de staging) ---
human_owners      = ["user:dev@boosterchile.com"]
github_repository = "boosterchile/booster-ai"

# --- Tamaños mínimos (staging no lleva tráfico real) ---
cloudsql_tier                  = "db-custom-1-3840"
cloudsql_backup_retention_days = 7
cloudsql_high_availability     = false
redis_tier                     = "BASIC"
redis_memory_gb                = 1
monthly_budget_usd             = 250
alert_email                    = "dev@boosterchile.com"

# --- State y facturación del propio proyecto ---
# Bucket propio de staging; lo crea el apply de prod (tfstate-staging.tf).
# Nunca el de prod: la SA de drift de staging recibe lectura sobre este bucket.
tfstate_bucket = "booster-ai-tfstate-stg-494222"
# Export de billing de staging: se crea en el dataset billing_export del
# proyecto de staging (consola → Billing → Billing export). Hasta entonces,
# apuntar al de prod deja el dashboard de costos de staging vacío.
billing_export_table = "booster-ai-stg-494222.billing_export.gcp_billing_export_v1_019461_C73CDE_DCE377"

# Staging no delega subdominios. La delegación NS la hace el tfvars de PROD
# con los nameservers del output dns_zone_name_servers tras el apply de staging.
staging_nameservers = []

# --- Flags explícitos de higiene ---
# strict_migration_ordering: staging debe fallar si el orden de migraciones no cuadra.
strict_migration_ordering = true

# content_sid_ready: el default de variables.tf monta los cinco content-sid
# porque en PROD ya tienen su valor real. En staging nacen con el placeholder
# ROTATE_ME_*, que no pasa la validación `^HX` del api: montados, el primer
# deploy real no arranca (INC-2026-06-19). Mapa vacío = ninguno montado. Pasa
# a true cada uno solo después de cargar su `HX...` de prueba.
content_sid_ready = {}

# --- Flags que NO se listan aquí a propósito ---
# Usan el default de infrastructure/variables.tf. No los actives en el primer
# apply de staging sin visto del PO (y nunca copies valores de prod a ciegas):
#   notifications_shadow / notifications_via_microservice  = false
#   matching_shadow / matching_via_microservice             = false
#   matching_elegibilidad_modo                             = "activa" (default del módulo;
#     prod corre activa desde el 2026-11-16; staging puede heredar el default o
#     fijar "sombra" o "vigente" en el tfvars local si el PO quiere un entorno más quieto)
#   document_service_push                                  = true (ADR-085)
#   resend_api_key_ready                                   = false
#     → montar solo después de cargar el secreto real (docs/runbooks/terraform-apply.md)
#   rutas_api_activada                                     = true (default del módulo
#     tras visto PO 2026-11-16; staging gemelo puede heredar o fijar false local)
#   matching "activa"                                      = fuera de este tfvars;
#     es decisión de prod del PO, no del bootstrap de staging.
